# Keep the build context small and secrets out of the image.
.env
.env.*
!.env.example

.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated widget builds — recreated at runtime, and can be very large.
workspace/
.template-project/node_modules/

.git/
.github/
*.md
!README.md

.idea/
.vscode/
.DS_Store
