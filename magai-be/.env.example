# ---------------------------------------------------------------------------
# Magnitai backend configuration. Copy to .env and fill in.
# Every variable is prefixed MAGAI_ and maps to a field in
# app/platform/config/settings.py.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# development | staging | production
# In production the app refuses to start with an insecure SECRET_KEY, a wildcard
# CORS origin, DEBUG on, or private-URL fetching enabled.
MAGAI_ENVIRONMENT=development
MAGAI_DEBUG=false

# --- Datastores ------------------------------------------------------------
MAGAI_DATABASE_URL=postgresql+asyncpg://localhost:5432/magai
MAGAI_REDIS_URL=redis://localhost:6379/0
MAGAI_CELERY_BROKER_URL=redis://localhost:6379/1
MAGAI_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth (REQUIRED) -------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates every issued token, logging all users out.
MAGAI_SECRET_KEY=change-me-in-production
MAGAI_ACCESS_TOKEN_TTL_MINUTES=30
MAGAI_REFRESH_TOKEN_TTL_DAYS=30
MAGAI_PASSWORD_MIN_LENGTH=12
# A reset link is a password equivalent while it lives, so keep this short.
MAGAI_PASSWORD_RESET_TTL_MINUTES=30
MAGAI_EMAIL_VERIFICATION_TTL_HOURS=48
# Unverified accounts can sign in and read, but cannot spend build budget.
MAGAI_REQUIRE_VERIFIED_EMAIL_TO_BUILD=true

# --- Email -----------------------------------------------------------------
# "console" logs the message (including reset links) instead of sending, so
# development and CI need no credentials and cannot mail real users.
# Set to "smtp" in production.
MAGAI_EMAIL_BACKEND=console
MAGAI_EMAIL_FROM=Magnitai <no-reply@magnitai.local>
MAGAI_SMTP_HOST=localhost
MAGAI_SMTP_PORT=587
MAGAI_SMTP_USERNAME=
MAGAI_SMTP_PASSWORD=

# --- MFA -------------------------------------------------------------------
# Shown as the account issuer in authenticator apps.
MAGAI_MFA_ISSUER=Magnitai
MAGAI_MFA_RECOVERY_CODE_COUNT=8

# --- HTTP security ---------------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser.
# Never "*" — credentials are enabled.
MAGAI_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated Host header values to accept ("*" disables the check).
# Set to your real domains in production to block Host-header injection.
MAGAI_TRUSTED_HOSTS=*
MAGAI_MAX_REQUEST_BYTES=1048576

# --- Rate limiting ---------------------------------------------------------
# Format: "<count>/<second|minute|hour|day>".
MAGAI_RATE_LIMIT_ENABLED=true
MAGAI_RATE_LIMIT_ANALYZE=10/hour
MAGAI_RATE_LIMIT_BUILD=5/hour
MAGAI_RATE_LIMIT_PREVIEW=20/hour
MAGAI_RATE_LIMIT_LEAD_SUBMIT=30/minute
# Generous: one view per page load, and a busy host page produces real bursts.
MAGAI_RATE_LIMIT_IMPRESSION=120/minute
MAGAI_RATE_LIMIT_AUTH=10/minute

# --- SSRF guard ------------------------------------------------------------
# Only ever true on a trusted dev machine: it allows the analyzer to fetch
# private/loopback addresses, which is an SSRF vector.
MAGAI_ALLOW_PRIVATE_TARGET_URLS=false

# --- AI / third party ------------------------------------------------------
MAGAI_GEMINI_API_KEY=
MAGAI_STITCH_API_KEY=
MAGAI_GOOGLE_CLIENT_ID=
MAGAI_AGY_MODEL=gemini-3.6-flash
MAGAI_VERCEL_API_TOKEN=
MAGAI_STRIPE_SECRET_KEY=
MAGAI_STRIPE_WEBHOOK_SECRET=
MAGAI_WIDGET_LAUNCH_PRICE_CENTS=9900
MAGAI_WIDGET_LAUNCH_CURRENCY=usd
MAGAI_STUDIO_MONTHLY_PRICE_CENTS=9900
MAGAI_STUDIO_ACTIVE_EXPERIENCE_LIMIT=3
MAGAI_SCALE_MONTHLY_PRICE_CENTS=19900
MAGAI_SCALE_ACTIVE_EXPERIENCE_LIMIT=10

# --- URLs ------------------------------------------------------------------
MAGAI_FRONTEND_BASE_URL=http://localhost:3000
MAGAI_SITE_URL=http://localhost:8000

# --- Self-healing ----------------------------------------------------------
MAGAI_SELF_HEAL_ENABLED=true
MAGAI_SELF_HEAL_INTERVAL_MINUTES=360
MAGAI_SELF_HEAL_BATCH_SIZE=25
MAGAI_SELF_HEAL_MAX_FAILURES=3

# --- Observability ---------------------------------------------------------
# json for production (aggregator-friendly), text for local readability.
MAGAI_LOG_FORMAT=text
MAGAI_LOG_LEVEL=INFO
MAGAI_METRICS_ENABLED=true
# Requires the "sentry" extra: uv sync --extra sentry
MAGAI_SENTRY_DSN=
MAGAI_SENTRY_TRACES_SAMPLE_RATE=0.1
