# Normalise to LF in the repository, and let Git pick the working-copy ending.
* text=auto

# These are executed by a Linux kernel, not read by an editor. A CRLF checkout
# turns `#!/usr/bin/env bash` into `bash\r`, which fails as "bad interpreter" —
# and this repository is developed on Windows and runs its scripts on
# ubuntu-latest in CI, which is exactly the pairing that produces it.
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Entrypoints and config read inside containers, same reasoning.
docker-compose.yml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Python is tolerant of CRLF but the formatters are not: `ruff format --check`
# is a CI gate, and a CRLF working copy makes it disagree with the committed
# file on every line.
*.py text eol=lf

# Web sources, for the same reason on the Prettier side.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Lockfiles: collapse them in reviews and never try to merge them by hand.
pnpm-lock.yaml linguist-generated=true -diff
uv.lock linguist-generated=true -diff

# Generated by the TanStack router plugin; reviewing it is noise.
magai-fe/src/routeTree.gen.ts linguist-generated=true -diff

# Binary assets — never munge, never diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
